# Database settings
DATABASE_URL=postgresql+asyncpg://fastapi:fastapi@localhost:5432/fastapi

DB_HOST=db
DB_PORT=5432
DB_NAME=fastapi
DB_USER=fastapi
DB_PASSWORD=fastapi

# FastAPI settings
